# Postgres Configuration
DATABASE_URL=postgres://ejc_hub:ejc_hub@localhost:5434/ejc_hub

# App Configuration
PORT=4000

# Auth0 Configuration
AUTH_TENANT_DOMAIN=my-tenant.us.auth0.com # Auth0 Domain
AUTH_AUDIENCE=my-api-identifier # Auth0 Application API Identifier

# PostHog Configuration (optional; error capture is off without a key)
POSTHOG_API_KEY=phc_my-project-api-key # PostHog Project API Key
POSTHOG_HOST=https://us.i.posthog.com # PostHog Host (defaults to US cloud)
