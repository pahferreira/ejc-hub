{
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "scripts": {
    "sandcastle": "npx tsx .sandcastle/main.mts",
    "prepare": "husky",
    "test": "node --test scripts/hooks/changed-packages.spec.mjs scripts/hooks/pre-push-steps.spec.mjs"
  },
  "lint-staged": {
    "api/src/**/*.{ts,js}": "npm --prefix api run lint:staged --",
    "api/**": "npm --prefix api run format:staged --"
  }
}
