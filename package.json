{
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "scripts": {
    "sandcastle": "npx tsx .sandcastle/main.mts",
    "prepare": "husky",
    "test": "node --test scripts/hooks/changed-packages.spec.mjs scripts/hooks/pre-push-steps.spec.mjs scripts/hooks/lockfile-packages.spec.mjs"
  },
  "lint-staged": {
    "api/src/**/*.{ts,js}": "npm --prefix api run lint:staged --",
    "api/**": "npm --prefix api run format:staged --",
    "app/**/*.{ts,tsx}": [
      "app/node_modules/.bin/prettier --write --ignore-path app/.prettierignore",
      "app/node_modules/.bin/eslint --fix --config app/eslint.config.js"
    ],
    "app/**/!(*.ts|*.tsx)": [
      "app/node_modules/.bin/prettier --write --ignore-unknown --ignore-path app/.prettierignore"
    ],
    "common/**/*.ts": [
      "npm --prefix common exec -- prettier --write --ignore-path common/.prettierignore",
      "npm --prefix common exec -- eslint --config common/eslint.config.mjs --fix"
    ],
    "common/**/*.{mjs,json,md}": "npm --prefix common exec -- prettier --write --ignore-path common/.prettierignore"
  }
}
